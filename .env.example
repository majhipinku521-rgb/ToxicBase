# GEMINI_API_KEY: Required for Gemini AI API calls.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# TOXICBASE_REMOTE_BACKEND_URL: Optional external Node.js/Express ToxicBase server URL (e.g. https://api.toxicbase.yourdomain.com)
# When empty or default, the embedded local ToxicBase HTTP REST BaaS server (http://127.0.0.1:8765) is used automatically.
TOXICBASE_REMOTE_BACKEND_URL=http://127.0.0.1:8765

# TWILIO_ACCOUNT_SID: Server-side Twilio Account SID for dispatching real carrier SMS OTPs.
# Configure via the Secrets panel in AI Studio.
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID

# TWILIO_AUTH_TOKEN: Server-side Twilio Auth Token for dispatching real carrier SMS OTPs.
# Configure via the Secrets panel in AI Studio.
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN

# TWILIO_FROM_NUMBER: Server-side Twilio sender phone number in E.164 format (e.g., +15005550006).
TWILIO_FROM_NUMBER=+15005550006

# TOXICBASE_JWT_SECRET: Server-side HMAC-SHA256 signing secret for access & refresh tokens.
TOXICBASE_JWT_SECRET=tb_live_hmac_sha256_signing_secret_9f8e7d6c5b4a3f2e1d0c
